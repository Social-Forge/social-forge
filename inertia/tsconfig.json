{
  "extends": "@adonisjs/tsconfig/tsconfig.client.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "ESNext",
    "jsxImportSource": "vue",
    // vue-tsc's noUnusedLocals miscounts string template refs (`ref="fooRef"`)
    // as unused, causing false positives in vendored shadcn-vue components.
    // ESLint enforces unused-vars for .vue files template-aware instead.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "~/*": ["./*"],
      "@generated/*": ["../.adonisjs/client/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.d.ts",
    "./**/*.vue",
    "auto-imports.d.ts",
    "components.d.ts",
    "../.adonisjs/client/**/*.ts",
    "../.adonisjs/server/**/*.ts"
  ]
}
