{
  "__inputs": [],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "title": "Social Forge — Overview",
  "tags": ["socialforge"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Active tenants",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sf_tenants_total", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Active conversations",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sf_conversations_active", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Pending outbox",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "sf_outbox_pending", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Process uptime (s)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "sf_process_uptime_seconds", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Message throughput (per second)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "rate(sf_messages_inbound_total[5m])", "legendFormat": "inbound", "refId": "A" },
        { "expr": "rate(sf_messages_outbound_total[5m])", "legendFormat": "outbound", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "AI replies (per second)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "rate(sf_ai_replies_total[5m])", "legendFormat": "ai replies", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Resident memory (bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "sf_process_resident_memory_bytes", "legendFormat": "rss", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Outbox backlog",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "sf_outbox_pending", "legendFormat": "pending", "refId": "A" }]
    }
  ]
}
