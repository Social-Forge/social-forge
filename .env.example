##====================================
## NODE
##====================================
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
DOMAIN=localhost
LETSENCRYPT_EMAIL=support@socialforge.io
##====================================
## APP
##====================================
VITE_APP_NAME="Social Forge"
LOG_LEVEL=info
# Generate with: node ace generate:key
APP_KEY=
APP_URL=http://${HOST}:${PORT}
##====================================
## SESSION
##====================================
SESSION_DRIVER=cookie
LIMITER_STORE=redis
##====================================
## POSTGRESQL
##====================================
DB_CONNECTION=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_DATABASE=social_forge
POSTGRES_HOST_PORT=5432
##====================================
## REDIS
##====================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_HOST_PORT=6379
##====================================
## RABBITMQ
##====================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=forge
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=social_forge
RABBITMQ_MGMT_PORT=15672
##====================================
## TYPESENSE (search)
##====================================
TYPESENSE_API_KEY=change_me
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
##====================================
## MINIO (S3 storage)
##====================================
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_SERVER_URL=http://localhost:9000
MINIO_BUCKET=socialforge
MINIO_REGION=eu-west-1
##====================================
## CENTRIFUGO (realtime)
##====================================
CENTRIFUGO_TOKEN_SECRET=change_me
CENTRIFUGO_API_KEY=change_me
CENTRIFUGO_ADMIN_PASSWORD=change_me
CENTRIFUGO_ADMIN_SECRET=change_me
##====================================
## WAHA (WhatsApp) — session storage in Postgres, media in MinIO
## Points at the `postgres` compose service (not localhost).
##====================================
WHATSAPP_SESSIONS_POSTGRESQL_URL=postgresql://postgres:change_me@postgres:5432/social_forge?sslmode=disable
# GOWS history-sync tuning (see https://waha.devlike.pro/docs/engines/gows/)
WAHA_GOWS_DEVICE_REQUIRE_FULL_SYNC=false
WAHA_GOWS_DEVICE_HISTORY_SYNC_FULL_SYNC_DAYS_LIMIT=365
WAHA_GOWS_DEVICE_HISTORY_SYNC_RECENT_SYNC_DAYS_LIMIT=30
WAHA_GOWS_DEVICE_HISTORY_SYNC_INITIAL_SYNC_MAX_MESSAGES_PER_CHAT=100
WAHA_GOWS_DEVICE_HISTORY_SYNC_FULL_SYNC_SIZE_MB_LIMIT=512
WAHA_GOWS_DEVICE_HISTORY_SYNC_STORAGE_QUOTA_MB=1024
# WebJS worker
WAHA_WEBJS_PORT=3000
WAHA_WEBJS_WORKER_ID="waha-worker-1"
WAHA_WEBJS_API_KEY=change_me
WAHA_WEBJS_DASHBOARD_USERNAME=admin
WAHA_WEBJS_DASHBOARD_PASSWORD=change_me
# NoWeb worker
WAHA_NOWEB_PORT=3001
WAHA_NOWEB_WORKER_ID="waha-worker-2"
WAHA_NOWEB_API_KEY=change_me
WAHA_NOWEB_DASHBOARD_USERNAME=admin
WAHA_NOWEB_DASHBOARD_PASSWORD=change_me
# GoWS worker (default engine)
WAHA_GOWS_PORT=3002
WAHA_GOWS_WORKER_ID="waha-worker-3"
WAHA_GOWS_API_KEY=change_me
WAHA_GOWS_DASHBOARD_USERNAME=admin
WAHA_GOWS_DASHBOARD_PASSWORD=change_me
##====================================
## META (WhatsApp Business / Messenger / Instagram — Graph API)
## Per-channel tokens are stored encrypted in DB; these are app-level.
##====================================
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=change_me
META_GRAPH_API_VERSION=v21.0
##====================================
## TELEGRAM (Bot API)
## Per-bot tokens stored encrypted in DB; this is the webhook secret.
##====================================
TELEGRAM_WEBHOOK_SECRET=change_me
##====================================
## AI PROVIDERS (multi-provider — see packages/ai)
##====================================
AI_DEFAULT_PROVIDER=claude
AI_DEFAULT_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
##====================================
## PAYMENT GATEWAYS (Xendit first, then Midtrans, PayPal)
##====================================
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
##====================================
## MAILER
##====================================
MAIL_MAILER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=no-reply@socialforge.io
SMTP_PASSWORD=change_me
SMTP_FROM_NAME="Social Forge"
SMTP_FROM_EMAIL=no-reply@socialforge.io
MAIL_FROM_NAME="Social Forge"
MAIL_FROM_ADDRESS=no-reply@socialforge.io
RESEND_API_KEY=your-resend-api-key
##====================================
## APP CONFIG ADDITIONAL
##====================================
ENABLE_REGISTRATION=false
DEFAULT_ADMIN_EMAIL=admin@socialforge.io
DEFAULT_ADMIN_PASSWORD=change_me
##====================================
## GRAFANA / MONITORING (profile: monitoring)
##====================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_ADMIN_EMAIL=admin@socialforge.io
GRAFANA_ADMIN_ORG_NAME="Social Forge"
GRAFANA_HOST_PORT=3003
GRAFANA_ROOT_URL=http://localhost:3003
##====================================
## SOCIAL OAuth (Ally)
## Register these exact callback URLs in each provider console:
##   ${APP_URL}/oauth/google/callback | /oauth/github/callback | /oauth/facebook/callback
##====================================
# Google OAuth
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_CALLBACK_URL=http://localhost:3333/oauth/google/callback
# GitHub OAuth
GITHUB_CLIENT_ID=placeholder
GITHUB_CLIENT_SECRET=placeholder
GITHUB_CALLBACK_URL=http://localhost:3333/oauth/github/callback
# Facebook OAuth
FACEBOOK_CLIENT_ID=placeholder
FACEBOOK_CLIENT_SECRET=placeholder
FACEBOOK_CALLBACK_URL=http://localhost:3333/oauth/facebook/callback
##====================================
## CENTRIFUGO WEBSOCKET (browser)
##====================================
CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket
##====================================
## DRIVE
##====================================
DRIVE_DISK=fs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=